            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/widget_row_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:background="@drawable/widget_row"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingRight="8dp">

                <!-- 체크 칸. 그림 크기와 터치 영역을 패딩으로 분리한다 — background에 shape를 걸면
                     뷰 전체가 칠해져 48x40dp짜리 거대한 네모가 그려지므로 src로 옮겼다. 그려지는
                     사각형은 content box(20x20dp)이고 터치는 뷰 전체(48x40dp = 지금의 7.5배)가 받는다. -->
                <ImageView
                    android:id="@+id/widget_check_0"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:src="@drawable/widget_check" />

                <!-- 쓰는 중 표시. 체크 칸과 같은 칸·같은 폭(48dp)이라 줄의 들여쓰기가 흔들리지 않는다. -->
