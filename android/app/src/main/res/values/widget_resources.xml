<?xml version="1.0" encoding="utf-8"?>
<!-- tool/generate_widget_resources.dart가 생성한다. 직접 고치지 말 것 —
     문구는 lib/core/strings.dart, 색은 lib/core/theme/retro_palette.dart에서 온다. -->
<resources>
    <!-- 위젯 선택기에 뜨는 이름과 설명. 위젯을 올리기 전에는 캐시가 쓰이지 않는다. -->
    <string name="todo_widget_name">투두두두 할 일</string>
    <string name="todo_widget_description">남은 할 일을 홈 화면에서 보고 체크해요.</string>
    <!-- 캐시가 아직 없거나 판 번호를 모를 때의 마지막 한 줄. 빈 사각형을 보여 주지 않는다. -->
    <string name="todo_widget_no_cache">앱을 한 번 열어 주세요</string>
    <!-- 앱 화면과 같은 레트로 색. 위젯은 다크 모드에서도 같은 색을 쓴다. -->
    <color name="widget_paper">#FFF3EAD3</color>
    <color name="widget_surface">#FFFFF8E7</color>
    <color name="widget_sunken">#FFE3D6B8</color>
    <color name="widget_line">#FFC9BA98</color>
    <color name="widget_ink">#FF231F3A</color>
    <color name="widget_ink_muted">#FF57506B</color>
    <color name="widget_danger">#FFB8323A</color>
</resources>
