<?xml version="1.0" encoding="utf-8"?>
<!-- tool/generate_widget_resources.dart가 생성한다. 직접 고치지 말 것 —
     문구는 lib/core/strings.dart, 색은 lib/core/theme/app_palette.dart에서 온다. -->
<resources>
    <!-- 위젯 선택기에 뜨는 이름과 설명. 위젯을 올리기 전에는 캐시가 쓰이지 않는다. -->
    <string name="todo_widget_name">투두두두 할 일</string>
    <string name="todo_widget_description">남은 할 일을 홈 화면에서 보고 체크해요.</string>
    <!-- 캐시가 아직 없거나 판 번호를 모를 때의 마지막 한 줄. 빈 사각형을 보여 주지 않는다. -->
    <string name="todo_widget_no_cache">앱을 한 번 열어 주세요</string>
    <!-- 앱 화면과 같은 팔레트(redesign). 위젯은 다크 모드에서도 같은 색을 쓴다. -->
    <color name="widget_background">#FFEEF1F6</color>
    <color name="widget_surface">#FFFFFFFF</color>
    <color name="widget_sunken">#FFE2E7EF</color>
    <color name="widget_line">#FFD3D9E3</color>
    <color name="widget_outline">#FF6B7289</color>
    <color name="widget_ink">#FF1B2033</color>
    <color name="widget_ink_muted">#FF4A5168</color>
    <color name="widget_danger">#FFCC2F3F</color>
</resources>
