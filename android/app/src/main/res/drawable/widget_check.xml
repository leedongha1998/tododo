<?xml version="1.0" encoding="utf-8"?>
<!-- 체크 칸. PixelIcons는 Flutter가 직접 그리는 것이라 RemoteViews에 재사용할 수 없어
     눌린 면(sunken) + 2dp 선으로 대신한다. 6단계에서 이 칸에 체크 PendingIntent가 걸린다. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_sunken" />
    <stroke android:width="2dp" android:color="@color/widget_ink" />
</shape>
