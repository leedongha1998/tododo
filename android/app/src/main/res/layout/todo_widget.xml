                     제목과 기한에 따로 걸지 않는다(기한을 눌러도 같은 결과여야 한다). -->
                <LinearLayout
                    android:id="@+id/widget_text_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_title_5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/widget_ink"
                        android:textSize="14sp" />

                    <!-- 기한. 기본이 gone이고 캐시에 기한 키가 있는 줄에서만 켜진다(design 6.3).
                         기한이 없는 줄에는 대체 문구·기호를 그리지 않는다. -->
                    <TextView
                        android:id="@+id/widget_due_5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/widget_ink_muted"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- "그 외 N개". 담기지 않는 할 일이 있을 때 마지막 줄 하나를 이 줄로 바꿔 쓴다. -->
            <TextView
                android:id="@+id/widget_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="2dp"
                android:paddingTop="2dp"
                android:textColor="@color/widget_ink_muted"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 목록 대신 가운데에 띄우는 안내(로그인하지 않음·조회 중·빈 목록·전부 완료·조회 실패).
             캐시가 아예 없을 때의 한 줄도 이 자리에 들어간다. -->
        <TextView
            android:id="@+id/widget_center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/widget_ink_muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>
    <!-- 아래 한 줄은 **없다**(2026-11-18 추가 범위 2). note는 위 머리 줄로 올라갔다 —
         두 자리에 두면 기준 시각이 두 번 보인다(spec 수용 기준: 한 자리에서만). -->
</LinearLayout>
