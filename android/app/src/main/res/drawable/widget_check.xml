<?xml version="1.0" encoding="utf-8"?>
<!-- 체크 칸. 앱 체크박스는 Flutter가 직접 그리는 것이라 RemoteViews에 재사용할 수 없어 같은 인상
     (흰 면 + 2dp outline 선, 모서리 4dp)으로 대신 그린다. 이 칸에 체크 PendingIntent가 걸린다. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <stroke android:width="2dp" android:color="@color/widget_outline" />
    <corners android:radius="4dp" />
</shape>
