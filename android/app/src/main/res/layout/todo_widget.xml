                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/widget_ink_muted"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_row_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_row_line"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp">

                <!-- 체크 칸. 그림 크기와 터치 영역을 패딩으로 분리한다 — background에 shape를 걸면
                     뷰 전체가 칠해져 48x40dp짜리 거대한 네모가 그려지므로 src로 옮겼다. 그려지는
                     사각형은 content box(20x20dp)이고 터치는 뷰 전체(48x40dp = 지금의 7.5배)가 받는다. -->
                <ImageView
                    android:id="@+id/widget_check_5"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:src="@drawable/widget_check" />

                <!-- 쓰는 중 표시. 체크 칸과 같은 칸·같은 폭(48dp)이라 줄의 들여쓰기가 흔들리지 않는다. -->
                <TextView
                    android:id="@+id/widget_pending_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:minWidth="48dp"
                    android:textColor="@color/widget_ink_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- 제목과 기한을 감싼 칸. **앱 열기 PendingIntent가 걸리는 자리**다(design 4.5) —
                     제목과 기한에 따로 걸지 않는다(기한을 눌러도 같은 결과여야 한다). -->
                <LinearLayout
                    android:id="@+id/widget_text_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_title_5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/widget_ink"
                        android:textSize="14sp" />

                    <!-- 기한. 기본이 gone이고 캐시에 기한 키가 있는 줄에서만 켜진다(design 6.3).
                         기한이 없는 줄에는 대체 문구·기호를 그리지 않는다. -->
                    <TextView
                        android:id="@+id/widget_due_5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/widget_ink_muted"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- "그 외 N개". 담기지 않는 할 일이 있을 때 마지막 줄 하나를 이 줄로 바꿔 쓴다. -->
            <TextView
                android:id="@+id/widget_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:textColor="@color/widget_ink_muted"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 목록 대신 가운데에 띄우는 안내(로그인하지 않음·조회 중·빈 목록·전부 완료·조회 실패).
             캐시가 아예 없을 때의 한 줄도 이 자리에 들어간다. -->
        <TextView
            android:id="@+id/widget_center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:textColor="@color/widget_ink_muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>
    <!-- 아래 한 줄은 **없다**(2026-11-18 추가 범위 2). note는 위 머리 줄로 올라갔다 —
         두 자리에 두면 기준 시각이 두 번 보인다(spec 수용 기준: 한 자리에서만). -->
</LinearLayout>
