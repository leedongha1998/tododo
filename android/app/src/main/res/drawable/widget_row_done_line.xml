<?xml version="1.0" encoding="utf-8"?>
<!-- 완료한 할 일 한 줄의 면(가라앉은 면 sunken). 장식이 아니라 상태 표시다 — 앱의 할 일 목록이
     완료한 줄에 쓰는 바로 그 면이다.
     2026-11-19 시안 C: **구분선 층을 넣지 않는다** — 채워진 면의 아래 끝에 다시 1dp 선을 그으면
     면의 경계와 선이 겹쳐 지저분해진다. 완료 줄은 면 자체가 경계다(design 6.1.3 (3)).
     좌·우 8dp 인셋은 필수다: 전폭으로 두면 마지막 줄이 완료 줄일 때 회색 사각형 귀퉁이가 판의
     둥근 모서리 밖으로 약 8.25dp 삐져나온다(design 6.1.3 (2)).
     색은 res/values/widget_resources.xml(생성 파일)에서 온다. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="8dp"
        android:right="8dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_sunken" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
