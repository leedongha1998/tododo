<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 전체 틀. 앱 화면 배경(background)과 같은 면, 모서리 16dp, 테두리·두께 없음(redesign design 7.4) —
     홈 화면 위에서 앱과 같은 인상을 낸다. Android 12+ 런처는 위젯 바깥 모서리를 시스템 반지름으로 따로 깎는다.
     색은 res/values/widget_resources.xml(생성 파일)에서 온다. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_background" />
    <corners android:radius="16dp" />
</shape>
